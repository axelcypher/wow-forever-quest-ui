<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\Blizzard_SharedXML\UI.xsd">
	<!-- Zeilenvorlagen der ScrollBox. Eigene Vorlagen je Zeilenart, damit die Frame-Pools getrennt bleiben.
	     Die Regionen werden im OnLoad der Mixins (UI/ListKit.lua, UI/List.lua, UI/RewardList.lua) angelegt. -->
	<Button name="ForeverQuestUIHeaderRowTemplate" mixin="ForeverQuestUIHeaderRowMixin" virtual="true">
		<Size x="300" y="18"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>

	<Button name="ForeverQuestUIQuestRowTemplate" mixin="ForeverQuestUIQuestRowMixin" virtual="true">
		<Size x="300" y="18"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Button name="ForeverQuestUIRewardRowTemplate" mixin="ForeverQuestUIRewardRowMixin" virtual="true">
		<Size x="300" y="30"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>
</Ui>
