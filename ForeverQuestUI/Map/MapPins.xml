<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\Blizzard_SharedXML\UI.xsd">
	<!-- Virtuelles Pin-Template für den Questatlas-DataProvider. Das Mixin wird in Map/MapPins.lua
	     (Pins:Init) mit MapCanvasPinMixin befüllt. Keine OnEnter/OnLeave-Skripte: das Map-System
	     ruft OnMouseEnter/OnMouseLeave des Mixins auf. -->
	<Frame name="ForeverQuestUIPinTemplate" mixin="ForeverQuestUIPinMixin" enableMouse="true" virtual="true">
		<Size x="18" y="18"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" atlas="UI-QuestPoi-OuterGlow" alphaMode="ADD" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-10" y="10"/>
						<Anchor point="BOTTOMRIGHT" x="10" y="-10"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
</Ui>
